# tg-bot-on-vercel — required environment (set these wherever you deploy)
# Copy to .env.local for local dev. NEVER commit real secrets.

# Sandbox credential: a Vercel API token (vercel.com/account/tokens).
# NOTE: when this app itself runs on Vercel, OIDC auth is automatic and
# this key is optional (used as fallback). Aliases: VERCEL_TOKEN.
V0_API_KEY=

# Optional for token auth OUTSIDE Vercel hosting (auto-detected on Vercel).
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# The Telegram bot token the sandbox bot will run with (@BotFather).
TG_BOT_TOKEN=

# Who may use the bot: numeric IDs and/or @usernames, comma/space separated.
TELEGRAM_ALLOWED_USERS=

# --- Model keys: at least ONE path must work (first available wins) ---
# 1) OpenCode Zen gateway key (opencode.ai dashboard → API keys). Enables
#    opencode/* models including free ones.
OPENCODE_API_KEY=
# 2) Direct provider keys (opencode picks these up headlessly):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Default model for the sandbox brain (must match an available key above).
OPENCODE_MODEL=opencode/muse-spark-1.3-contributor-free

# --- Sandbox tuning ---
# Deterministic sandbox name (one bot per deployment; enables resume).
SANDBOX_NAME=tg-bot-sandbox
# Session lifetime in minutes. Max 45 on Hobby, 300 on Pro/Enterprise.
# The /api/keepalive cron extends+resumes automatically within the max.
SANDBOX_TIMEOUT_MIN=40
# Set 1 to also install Chromium + Playwright MCP in the sandbox (slower setup).
WITH_BROWSER=0
